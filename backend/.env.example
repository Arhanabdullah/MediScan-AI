PROJECT_NAME=MediScan-AI API
OCR_BACKEND=auto
TESSERACT_CMD=
# Windows example (installer does not always add Tesseract to PATH):
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=1800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Medicine repository: json (default) or sqlite
# MEDICINE_REPO=json
# MEDICINE_DB_PATH=app/data/medicines.json
# MEDICINE_SQLITE_PATH=data/medicines.db

# Optional: point at an alternate synthetic demo fixture
# DEMO_TEXT_PATH=tests/fixtures/demo_prescription.txt

# Optional: JSON override for confidence weights (keys: ocr_engine,
# text_length, entity_coverage, medicine_match)
# CONFIDENCE_WEIGHTS={"ocr_engine":0.45,"text_length":0.15,"entity_coverage":0.2,"medicine_match":0.2}
# Optional: JSON override for the confidence A/B variant (weighted-v2).
# Has no effect until models.ab.enabled is true in config/confidence.yaml.
# CONFIDENCE_WEIGHTS_V2={"ocr_engine":0.40,"text_length":0.10,"entity_coverage":0.20,"medicine_match":0.30}

# Logging verbosity for structured pipeline logs: DEBUG, INFO, WARNING, ERROR
MEDISCAN_LOG_LEVEL=INFO
